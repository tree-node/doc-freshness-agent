# ============================================
# 機密情報（最重要: 絶対にコミットしない）
# ============================================
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
service-account*.json

# ============================================
# Python（バックエンド）
# ============================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ============================================
# Node / React（フロントエンド）
# ============================================
node_modules/
frontend/dist/
dist/
.vite/
*.local

# ============================================
# アプリのデータ・生成物（コードではないもの）
# ============================================
# DB・インデックス
*.sqlite
*.sqlite3
*.db
*.npy
data/index/
data/cache/

# 正本スナップショット・巡回結果（実行時に生成される）
data/snapshots/
data/events/

# 生成された修正版ファイル
outputs/
generated/

# LLM呼び出しログ・評価結果の生データ
logs/
eval_results/

# ============================================
# デモ・提出用素材（サイズが大きい/リポジトリ外で管理）
# ============================================
*.mp4
*.mov
demo_recordings/

# ============================================
# OS / エディタ
# ============================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ============================================
# Claude Code ローカル設定（共有しない個人設定のみ）
# ============================================
.claude/settings.local.json
