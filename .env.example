# このファイルを .env にコピーして値を埋める（.env はコミットされない）
# cp .env.example .env

# --- OrcaRouter ---
# 注意: ベースURLは使用するSDKのプロトコルで異なる（実装前にdocs-researcherで確認）
#   OpenAI互換SDK   → https://api.orcarouter.ai/v1
#   Anthropic SDK   → https://api.orcarouter.ai （/v1を付けない。SDKが自動付加するため）
ORCAROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1

# 段階別モデル（決定ログで管理。仮値）
MODEL_STAGE0=google/gemini-3.5-flash
MODEL_STAGE2=google/gemini-3.5-flash-lite
MODEL_STAGE3=anthropic/claude-sonnet-5
MODEL_ESCALATION=

# --- Embeddings（OrcaRouter非対応時のフォールバック用） ---
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=google/gemini-embedding-001

# --- 経路B（P1・着手判断後に設定） ---
GITHUB_TOKEN=

# --- アプリ設定 ---
WATCH_ROOT=./demo-data/監視対象
DB_PATH=./data/app.sqlite
# 正本（法令）のスナップショット置き場。時間巻き戻しデモの初期化先
SNAPSHOTS_DIR=./data/snapshots
