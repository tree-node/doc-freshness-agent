# このファイルを .env にコピーして値を埋める（.env はコミットされない）
# cp .env.example .env

# --- OrcaRouter ---
# 注意: ベースURLは使用するSDKのプロトコルで異なる（実装前にdocs-researcherで確認）
#   OpenAI互換SDK   → https://api.orcarouter.ai/v1
#   Anthropic SDK   → https://api.orcarouter.ai （/v1を付けない。SDKが自動付加するため）
ORCAROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxx
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1

# 段階別モデル（決定ログで管理。仮値）
MODEL_STAGE0=
MODEL_STAGE2=
MODEL_STAGE3=
MODEL_ESCALATION=

# --- Embeddings（OrcaRouter非対応時のフォールバック用） ---
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# --- 経路B（P1・着手判断後に設定） ---
GITHUB_TOKEN=

# --- アプリ設定 ---
WATCH_ROOT=./demo-data
DB_PATH=./data/app.sqlite
